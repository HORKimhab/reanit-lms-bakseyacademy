# OS / editor (backend/ and frontend/ have their own .gitignore)
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.log

# Safety net for env files anywhere (e.g. one for docker-compose)
.env
.env.*
!.env.example

