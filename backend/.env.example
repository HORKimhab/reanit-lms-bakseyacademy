# Homebrew Postgres (uses your macOS user, no password)
DATABASE_URL=postgres://localhost/reanit_lms
# Docker alternative: postgres://reanit:reanit@localhost:5432/reanit_lms
BIND_ADDR=127.0.0.1:8080
RUST_LOG=info,tower_http=info

# Lesson videos (Bunny Stream). Without a library id, lessons have no playable URL.
BUNNY_LIBRARY_ID=
# Embed-token key from the library's security settings; enables signed, expiring embed URLs.
BUNNY_TOKEN_KEY=

# Ebook files: S3-compatible bucket (Cloudflare R2, S3, MinIO). Without a bucket, downloads return 503.
STORAGE_BUCKET=
# R2: https://<account-id>.r2.cloudflarestorage.com · MinIO: http://127.0.0.1:9000
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# false → virtual-hosted URLs (bucket.endpoint/key)
STORAGE_PATH_STYLE=true

# Telegram channel storage (TODO section G). The bot must be an admin of the private channel.
TELEGRAM_BOT_TOKEN=
# Numeric id of the private channel, e.g. -1001234567890
TELEGRAM_CHANNEL_ID=
# Public API limits: 50 MB up / 20 MB down. For course videos run telegram-bot-api --local and point here.
TELEGRAM_API_URL=https://api.telegram.org
# With a --local server: its --dir as mounted for this API (getFile paths are read from disk)
TELEGRAM_LOCAL_DIR=
TELEGRAM_SERVER_DIR=/var/lib/telegram-bot-api
# Secret for setWebhook (secret_token); posts in the channel are imported into the media library
TELEGRAM_WEBHOOK_SECRET=
# Signs /media/{token} links (Telegram-stored files). Required when TELEGRAM_BOT_TOKEN is set.
MEDIA_SIGNING_KEY=
# Admins' group/channel (bot added) that receives payment screenshots; defaults to TELEGRAM_CHANNEL_ID
TELEGRAM_ADMIN_CHAT_ID=
